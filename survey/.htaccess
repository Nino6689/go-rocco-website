# ---------------------------------------------------------------
# Home Hub site survey - private field tool.
# Password protected; not part of the public go-rocco.com site.
# ---------------------------------------------------------------

AuthType Basic
AuthName "Home Hub Site Survey"
AuthUserFile /home/u629312178/domains/go-rocco.com/public_html/survey/.htpasswd
Require valid-user

# Never serve the credential file or this config
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

# Keep search engines out even if the directory is ever unprotected
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  Header set Referrer-Policy "no-referrer"
  # The app shell and worker must refresh promptly after a deploy
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

DirectoryIndex index.html
